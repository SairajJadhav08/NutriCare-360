# ── NutriCare-360 Backend Environment Variables ──────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Flask JWT secret — use a long random string in production
JWT_SECRET_KEY=your-super-secret-jwt-key-here

# ExerciseDB via RapidAPI — free tier (500 req/month, no credit card)
# Sign up at: https://rapidapi.com/justin-WFnsXH_t6/api/exercisedb
# Leave blank to use the local yoga.json fallback
RAPIDAPI_KEY=your-rapidapi-key-here
